# Supabase Dashboard > Project Settings > Database > Connection string.
# Với Vercel/serverless, ưu tiên Transaction Pooler và giữ sslmode=require.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Số kết nối tối đa mỗi instance server. Với Vercel + Transaction Pooler nên giữ nhỏ.
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT=10

# Khóa ký cookie phiên khách. Tạo bằng: openssl rand -base64 32
GUEST_SESSION_SECRET=replace-with-a-long-random-secret
