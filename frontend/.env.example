# Local dev: bỏ trống hết — dùng SQLite file ./local.db + secret dev.
# Chạy `npm run db:push` một lần để tạo schema.

# Vercel + Turso (https://turso.tech, gói free):
#   turso db create kydai && turso db show kydai --url && turso db tokens create kydai
# rồi đặt 3 biến dưới đây trong Vercel Project Settings → Environment Variables,
# và chạy `npm run db:push` với DATABASE_URL/DATABASE_AUTH_TOKEN trỏ vào Turso.
# DATABASE_URL=libsql://kydai-<org>.turso.io
# DATABASE_AUTH_TOKEN=...
# JWT_SECRET=<chuỗi ngẫu nhiên dài>

# Tuỳ chọn:
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=7
